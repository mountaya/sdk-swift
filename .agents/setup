#!/bin/sh
# Generated by mountaya/ai (scripts/apply.mjs). Edit .agents/manifest.json instead.
#
# Sets this clone up to be worked in: Entire, the repositories it builds against,
# the git hooks, the agents, Brain and the toolchain. It asks before each change,
# does only what is missing, and is what to run again to update.
#
#   sh .agents/setup            ask before each step
#   sh .agents/setup --yes      do every step
#   sh .agents/setup --check    report what is missing, change nothing (exit 1 if anything is)
set -eu
top=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '%s\n' 'Not in a git work tree. Clone the repository first: entire repo clone /et/mountaya/sdk-swift' >&2; exit 1; }
cd "$top"

yes=no
check=no
for arg in "$@"; do
  case "$arg" in --yes) yes=yes ;; --check) check=yes ;; esac
done

# ask <question>: yes under --yes, no under --check or without a terminal.
ask() {
  [ "$check" = no ] || return 1
  [ "$yes" = no ] || return 0
  [ -t 0 ] || return 1
  printf '%s [Y/n] ' "$1" >&2
  read -r answer
  case "$answer" in "" | y | Y | yes) return 0 ;; esac
  return 1
}

# missing <what> <how>: stops, naming the command that fixes it.
missing() {
  printf '✗ %s\n  %s\n' "$1" "$2" >&2
  exit 1
}

# --check hands straight over: setup.mjs reports the CLI and the login with the rest.
if [ "$check" = no ]; then
  if ! command -v entire >/dev/null 2>&1; then
    if command -v brew >/dev/null 2>&1 && ask "The Entire CLI hosts every Mountaya repository and is not installed. Install it with Homebrew?"; then
      brew install --cask entireio/tap/entire
    else
      missing "The Entire CLI is not installed: it hosts every Mountaya repository." 'brew install --cask entireio/tap/entire   (Linux: curl -fsSL https://entire.com/install.sh | bash)'
    fi
  fi

  if entire auth status 2>/dev/null | grep -q 'Not logged in'; then
    if ask "Log in to Entire now?"; then
      entire login
    else
      missing "Not logged in to Entire, so nothing can be cloned or pushed." "entire login"
    fi
  fi
fi

if [ ! -f ../ai/scripts/setup.mjs ]; then
  if ask "Clone mountaya/ai, the shared conventions and this setup, beside this repository as ../ai?"; then
    entire repo clone /et/mountaya/ai ../ai
  else
    missing "../ai is not checked out." 'entire repo clone /et/mountaya/ai ../ai'
  fi
fi

# mise installs every tool a repository pins, and the rest of the setup runs on the
# Node ai's mise.toml pins, so nothing else has to be installed first.
if ! command -v mise >/dev/null 2>&1; then
  if ask "mise installs every tool this repository pins and is not installed. Install it?"; then
    if command -v brew >/dev/null 2>&1; then brew install mise; else curl -fsSL https://mise.run | sh && PATH="$HOME/.local/bin:$PATH"; fi
  else
    missing "mise is not installed: it installs every tool this repository pins." 'brew install mise   (or: curl -fsSL https://mise.run | sh)'
  fi
fi
ai_dir=$(cd ../ai && pwd)
exec mise --cd "$ai_dir" exec -- node "$ai_dir/scripts/setup.mjs" "$PWD" "$@"
