#!/bin/sh
# Generated by mountaya/ai (scripts/apply.mjs). Edit .agents/manifest.json instead.
#
# The commits of the repositories this one's gate reads beside it, pinned in siblings.lock,
# so CI tests exactly what a person tested and a revert restores it.
#
#   sh .agents/siblings pin [<repository>...]   pin each sibling whose HEAD moved, or those named, at its HEAD
#   sh .agents/siblings check                   siblings.lock pins exactly the manifest's siblings
#   sh .agents/siblings status                  each pin beside its sibling's HEAD, work and push, and its CI run
#   sh .agents/siblings sync                    pre-commit: pin each sibling whose HEAD moved forward, and stage siblings.lock
#   sh .agents/siblings verify [<commit>...]    pre-push: stop where CI could never fetch a pin those commits carry
#   sh .agents/siblings at-pins                 before a release: stop unless each sibling is checked out, clean, at its pin
#   sh .agents/siblings checkout                in CI: fetch each sibling beside this one, at its pin
#   sh .agents/siblings impact                  the repositories checked out beside this one that the work reaches, and why
#   sh .agents/siblings gate                    the quick gate of each of them, one at a time, before a change is done
#
# pin and sync refuse a sibling with uncommitted or untracked files, and a commit no remote
# branch holds, because CI can only fetch what was pushed. A pin may name an unreleased commit
# on any branch: that is how unpublished work is tried here without a release.
#
# sync runs before every commit. It first stops the commit while any sibling checked out beside
# this one has uncommitted or untracked files or a HEAD no remote branch holds, naming each one,
# its first uncommitted paths and what to do, whatever the commit does to siblings.lock and
# whatever SIBLINGS_ALLOW_DRIFT names. It then pins the sibling commits the commit was tested
# against. It only moves a pin forward: a sibling behind or diverged from its pin stops the
# commit. It leaves alone a sibling that is not checked out, the pin of each one
# SIBLINGS_ALLOW_DRIFT names (space or comma separated), and every pin of a commit that changes
# siblings.lock itself or concludes a merge. A lock no commit carries yet, as pin writes it
# before a repository's first commit with it, goes into the commit, staged or not.
# Under `git commit <paths>` git commits from an index of its own, which sync cannot stage into:
# it stops there and says what to run instead.
#
# verify runs before every push, on siblings.lock as each pushed commit holds it (the working
# tree's, with no commit named). It stops where no remote branch holds a pin, or where the
# sibling's CI never ran on it, so no bundle of it exists; it warns where that run is queued,
# running, failed or cancelled, and where depot cannot say.
# It also stops a pushed commit that carries no siblings.lock, on which CI's checkout stops.
#
# at-pins runs before a release tags. It stops unless every sibling is checked out
# beside this one, has no uncommitted or untracked files and has its HEAD at its pin, naming each
# one that does not, so the release tags the commit CI tested against those pins. It reads
# only this machine: no remote, no depot.
#
# CI never clones a repository on Entire: a Depot CI job's token reaches only the repository it
# runs for. The CI of a repository others read publishes every pushed commit as a git bundle to
# Depot's registry, at $SIBLINGS_REGISTRY, which every job of the organisation reaches with the token
# Depot CI injects, and checkout fetches the bundle of the commit siblings.lock pins.
# checkout waits up to SIBLINGS_WAIT_SECONDS (600) for a bundle its sibling's CI has not
# published yet.
# impact and gate read every repository of the workspace checked out beside this one. A
# repository is changed where it has uncommitted or untracked files, commits its upstream branch
# lacks, or a HEAD other than the commit a repository reading it pins. Every repository that reads
# a changed one is reached too, transitively, and every one ai renders where ai changed. gate runs,
# one repository at a time in the order the pins give, its `mise run ci:quick`, the render check
# where ai changed and `mise run generate:check` where a sibling it reads is reached. It stops
# while a release runs from a repository checked out beside this one.
set -eu
top=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '%s\n' 'Not in a git work tree: .agents/siblings pins the siblings of a clone.' >&2; exit 1; }
cd "$top"
siblings='ai schemas'
github=''
bundled='ai schemas'
lock=siblings.lock
header='# The sibling commits CI tests this repository against. Written by `sh .agents/siblings pin`.'

# problem <what> [<next step>...]: what is wrong, and each thing to do about it.
problem() {
  printf '✗ %s\n' "$1" >&2
  shift
  for step in "$@"; do printf '  %s\n' "$step" >&2; done
}
die() { problem "$@"; exit 1; }

# Where a terminal shows colour, a warning is orange.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then on=$(printf '\033[38;5;208m'); off=$(printf '\033[0m'); else on=""; off=""; fi

# warn <what> [<next step>...]: a problem that stops nothing.
warn() {
  printf '%s! %s%s\n' "$on" "$1" "$off" >&2
  shift
  for step in "$@"; do printf '  %s\n' "$step" >&2; done
}

# git in ../<name>. A hook runs with GIT_DIR and GIT_INDEX_FILE naming this clone, which the
# sibling's git would otherwise read and write as its own.
sib() {
  sib_dir="../$1"
  shift
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX
    git --no-pager -C "$sib_dir" "$@"
  )
}
there() { [ -e "../$1/.git" ]; }
head_of() { sib "$1" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null; }
# changes <name>: the uncommitted and untracked paths of ../<name>, as git status lists them.
changes() { sib "$1" --no-optional-locks status --porcelain --untracked-files=normal 2>/dev/null; }
dirty() { [ -n "$(changes "$1")" ]; }
has() { sib "$1" cat-file -e "$2^{commit}" 2>/dev/null; }
# held <name> <commit>: a remote branch of ../<name> that holds <commit>, origin/main where it does.
held() {
  held_by=$(sib "$1" branch -r --contains "$2" 2>/dev/null | sed 's/^[* ]*//; / -> /d') || held_by=""
  printf '%s\n' "$held_by" | grep -x origin/main || printf '%s\n' "$held_by" | sed -n 1p
}
pushed() { [ -n "$(held "$1" "$2")" ]; }
short() { if [ -n "$1" ]; then printf '%s\n' "$1" | cut -c1-7; else echo none; fi; }
count() { if [ "$1" = 1 ]; then echo "1 commit"; else echo "$1 commits"; fi; }
# named <name> [<name>...]: whether the first is among the others.
named() {
  named_one=$1
  shift
  case " $* " in *" $named_one "*) return 0 ;; esac
  return 1
}

# subjects <name> <range>: the commits of <range> in ../<name>, one line each, the newest 20.
subjects() {
  subjects_n=$(sib "$1" rev-list --count "$2" 2>/dev/null) || subjects_n=0
  sib "$1" log --no-color --oneline --no-decorate -n 20 "$2" 2>/dev/null | sed 's/^/    /'
  [ "$subjects_n" -le 20 ] || echo "    ... and $((subjects_n - 20)) more"
}

# compare <name> <from> <to>: where <to> stands from <from> in ../<name>, in $rel: same, ahead,
# behind, diverged, or unknown where ../<name> lacks either. $rel_n counts the commits only <to>
# has, or only <from> has where <to> is behind; $rel_back, those only <from> has where they diverged.
compare() {
  rel_n=0
  rel_back=0
  if [ "$2" = "$3" ]; then
    rel=same
  elif ! has "$1" "$2" || ! has "$1" "$3"; then
    rel=unknown
  elif sib "$1" merge-base --is-ancestor "$2" "$3"; then
    rel=ahead
    rel_n=$(sib "$1" rev-list --count "$2..$3")
  elif sib "$1" merge-base --is-ancestor "$3" "$2"; then
    rel=behind
    rel_n=$(sib "$1" rev-list --count "$3..$2")
  else
    rel=diverged
    rel_n=$(sib "$1" rev-list --count "$2..$3")
    rel_back=$(sib "$1" rev-list --count "$3..$2")
  fi
}

# move <name> <from> <to>: how the pin of <name> moves, and the commits it moves over.
move() {
  if [ -z "$2" ]; then
    echo "$lock: $1 pinned at $(short "$3")"
    return 0
  fi
  compare "$1" "$2" "$3"
  case $rel in
    same) echo "$lock: $1 stays at $(short "$3")" ;;
    ahead)
      echo "$lock: $1 $(short "$2") -> $(short "$3"), $(count "$rel_n") forward:"
      subjects "$1" "$2..$3"
      ;;
    behind)
      echo "$lock: $1 $(short "$2") -> $(short "$3"), $(count "$rel_n") back:"
      subjects "$1" "$3..$2"
      ;;
    diverged)
      echo "$lock: $1 $(short "$2") -> $(short "$3"), onto another line of history that leaves $(count "$rel_back") behind:"
      subjects "$1" "$2..$3"
      ;;
    *) echo "$lock: $1 $(short "$2") -> $(short "$3"), from a commit ../$1 does not have" ;;
  esac
}

# The text of siblings.lock, where it exists, and the commit a lock's text pins a sibling at.
lock_text() { [ ! -f "$lock" ] || cat "$lock"; }
pin_of() { printf '%s\n' "$1" | awk -v n="$2" '!/^#/ && $1 == n { print $2; exit }'; }

# well_formed <lock text> <label>: dies unless each of its lines pins one full commit of a
# sibling, and no sibling twice.
well_formed() {
  wf_bad=$(printf '%s\n' "$1" | awk -v s=" $siblings " '
    /^#/ || NF == 0 { next }
    NF != 2 || $2 !~ /^[0-9a-f]+$/ || length($2) != 40 { print "has a line that is not <repository> <full commit>: " $0; exit }
    index(s, " " $1 " ") == 0 { print "pins " $1 ", which .agents/manifest.json does not list as a sibling"; exit }
    seen[$1]++ { print "pins " $1 " twice"; exit }')
  [ -z "$wf_bad" ] || die "$2 $wf_bad." "sh .agents/siblings pin"
}

# pins_every <lock text> <label>: dies unless it pins every sibling.
pins_every() {
  for every_name in $siblings; do
    [ -n "$(pin_of "$1" "$every_name")" ] || die "$2 pins no commit for $every_name." "sh .agents/siblings pin $every_name"
  done
}

check() {
  [ -f "$lock" ] || die "$lock is missing, so CI cannot know which sibling commits to test against." "sh .agents/siblings pin"
  well_formed "$(lock_text)" "$lock"
  pins_every "$(lock_text)" "$lock"
}

# relock <lock text> [<name>...]: a lock with each named sibling at the HEAD of ../<name>, and
# every other at its pin in <lock text>.
relock() {
  relock_from=$1
  shift
  printf '%s\n' "$header"
  for relock_name in $siblings; do
    if named "$relock_name" "$@"; then
      relock_at=$(head_of "$relock_name") || relock_at=""
    else
      relock_at=$(pin_of "$relock_from" "$relock_name")
    fi
    [ -n "$relock_at" ] || die "$lock pins no commit for $relock_name yet." "sh .agents/siblings pin $relock_name"
    printf '%s %s\n' "$relock_name" "$relock_at"
  done
}

# push_hint <name>: the command that pushes the HEAD of ../<name> to a branch.
push_hint() {
  if hint_branch=$(sib "$1" symbolic-ref -q --short HEAD); then
    echo "git -C ../$1 push origin $hint_branch"
  else
    echo "git -C ../$1 push origin HEAD:refs/heads/<branch>"
  fi
}

# listed <paths>: the first ten of <paths>, indented beneath a problem, and how many more there are.
listed() {
  listed_n=$(printf '%s\n' "$1" | wc -l | tr -d ' ')
  printf '%s\n' "$1" | sed -n '1,10s/^/    /p' >&2
  [ "$listed_n" -le 10 ] || echo "    ... and $((listed_n - 10)) more" >&2
}

# settled <name> <commit> <then>: whether ../<name> is clean and a remote branch holds <commit>.
# Says what stands in the way, the first uncommitted paths and what to do, then what; exits nothing.
settled() {
  settled_ok=yes
  if settled_paths=$(changes "$1") && [ -n "$settled_paths" ]; then
    problem "../$1 has uncommitted or untracked files, which CI could never fetch:"
    listed "$settled_paths"
    echo "  Commit them on a branch and push it, then $3." >&2
    settled_ok=no
  fi
  if ! pushed "$1" "$2"; then
    problem "../$1 is at $(short "$2"), which no remote branch holds, so CI could never fetch it." "$(push_hint "$1")   (any branch will do), then $3."
    settled_ok=no
  fi
  [ "$settled_ok" = yes ]
}

# pinnable <name> <commit> <then>: exits unless ../<name> is clean and a remote branch holds <commit>.
pinnable() { settled "$@" || exit 1; }

# pin [<name>...]: each sibling whose HEAD moved from its pin, or each one named, pinned at its HEAD.
pin() {
  for pin_name in "$@"; do
    case " $siblings " in *" $pin_name "*) ;; *) die "$pin_name is not a sibling of this repository: $siblings" ;; esac
  done
  pin_was=$(lock_text)
  moving=""
  for pin_name in $siblings; do
    if [ "$#" -gt 0 ] && ! named "$pin_name" "$@"; then continue; fi
    if ! there "$pin_name"; then
      if [ "$#" -gt 0 ] || [ -z "$(pin_of "$pin_was" "$pin_name")" ]; then die "../$pin_name is not checked out." "sh .agents/setup"; fi
      echo "../$pin_name is not checked out: its pin stays."
      continue
    fi
    pin_at=$(head_of "$pin_name") || die "../$pin_name has no commit to pin yet."
    if [ "$#" -eq 0 ] && [ "$pin_at" = "$(pin_of "$pin_was" "$pin_name")" ]; then
      if dirty "$pin_name"; then echo "../$pin_name has uncommitted or untracked files: its pin is its HEAD, without them."; fi
      continue
    fi
    pinnable "$pin_name" "$pin_at" "pin again"
    moving="$moving $pin_name"
  done
  # shellcheck disable=SC2086 # one word per sibling
  pin_now=$(relock "$pin_was" $moving) || exit 1
  [ "$pin_now" = "$pin_was" ] || printf '%s\n' "$pin_now" >"$lock"
  if [ -z "$moving" ]; then
    echo "Each sibling checked out beside this one is at its pin."
    return 0
  fi
  for pin_name in $moving; do move "$pin_name" "$(pin_of "$pin_was" "$pin_name")" "$(pin_of "$pin_now" "$pin_name")"; done
}

# sync: before a commit, every sibling checked out beside this one is committed and pushed, or
# the commit stops, naming each one that is not and what to do. Then each sibling whose HEAD moved
# forward from the pin that commit carries is pinned at its HEAD, and siblings.lock staged, so the
# commit pins what it was tested against. A commit that changes siblings.lock itself, or concludes
# a merge, keeps the pins it sets; a sibling behind or diverged from its pin stops the commit, as
# pinning it would move the pin back.
sync_lock() {
  allow=$(printf '%s\n' "${SIBLINGS_ALLOW_DRIFT:-}" | tr ',' ' ')
  for sync_name in $allow; do
    case " $siblings " in *" $sync_name "*) ;; *) warn "SIBLINGS_ALLOW_DRIFT names $sync_name, which is not a sibling of this repository: $siblings" ;; esac
  done
  # The checks ran on each sibling as it stands, so each one is committed and pushed, whatever this
  # commit does to siblings.lock and whatever SIBLINGS_ALLOW_DRIFT names. Every one that is not is
  # named before the commit stops.
  sync_unsettled=""
  for sync_name in $siblings; do
    there "$sync_name" || continue
    if ! sync_at=$(head_of "$sync_name"); then
      problem "../$sync_name has no commit yet, so CI could never fetch it." "Commit its work on a branch and push it, then commit again."
      sync_unsettled="$sync_unsettled $sync_name"
      continue
    fi
    settled "$sync_name" "$sync_at" "commit again" || sync_unsettled="$sync_unsettled $sync_name"
  done
  [ -z "$sync_unsettled" ] || exit 1
  # The lock this commit carries: the one in the index git commits from, else the working tree's.
  if sync_staged=$(git show ":$lock" 2>/dev/null); then
    sync_index=$sync_staged
    sync_tracked=yes
  else
    sync_index=""
    sync_tracked=no
    sync_staged=$(lock_text)
  fi
  sync_head=$(git show "HEAD:$lock" 2>/dev/null) || sync_head=""
  if [ "$sync_index" != "$sync_head" ]; then
    echo "$lock changes in this commit, which keeps the pins it sets."
    return 0
  fi
  if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    echo "This commit concludes a merge, which keeps the pins of $lock as the merge sets them."
    return 0
  fi
  moving=""
  for sync_name in $siblings; do
    sync_was=$(pin_of "$sync_staged" "$sync_name")
    if ! there "$sync_name"; then
      if [ -n "$sync_was" ]; then
        echo "../$sync_name is not checked out beside this one: its pin stays at $(short "$sync_was"), and CI fetches that."
      else
        echo "../$sync_name is not checked out beside this one, and nothing pins it yet."
      fi
      continue
    fi
    sync_at=$(head_of "$sync_name") || sync_at=""
    [ "$sync_at" != "$sync_was" ] || continue
    # shellcheck disable=SC2086 # one word per name
    if named "$sync_name" $allow; then
      echo "SIBLINGS_ALLOW_DRIFT: ../$sync_name is at $(short "$sync_at"), and its pin stays at $(short "$sync_was")."
      continue
    fi
    if [ -n "$sync_was" ]; then
      compare "$sync_name" "$sync_was" "$sync_at"
      sync_leave="Or leave its pin where it is: SIBLINGS_ALLOW_DRIFT=$sync_name git commit ..."
      sync_back="To pin it back on purpose: sh .agents/siblings pin $sync_name && git add $lock, then commit again."
      sync_bring="Bring ../$sync_name to its pin, then commit again: git -C ../$sync_name switch --detach $sync_was, or pull its branch."
      case $rel in
        ahead) ;;
        behind) die "../$sync_name is at $(short "$sync_at"), $(count "$rel_n") behind its pin $(short "$sync_was"), and a commit only moves a pin forward." "$sync_bring" "$sync_back" "$sync_leave" ;;
        diverged) die "../$sync_name is at $(short "$sync_at"), which diverged from its pin $(short "$sync_was") ($(count "$rel_n") only here, $(count "$rel_back") only at the pin), and a commit only moves a pin forward." "$sync_bring" "$sync_back" "$sync_leave" ;;
        *) die "../$sync_name does not have its pin $(short "$sync_was"), so whether its HEAD moves the pin forward is not known." "git -C ../$sync_name fetch, then commit again." "$sync_leave" ;;
      esac
    fi
    moving="$moving $sync_name"
  done
  if [ -z "$moving" ]; then
    # A lock no commit carries yet, as pin writes it before the first commit with it: CI stops on a commit without one,
    # so this commit carries it, staged or not.
    [ "$sync_tracked" = no ] && [ -f "$lock" ] || return 0
  fi
  # shellcheck disable=SC2086 # one word per sibling
  sync_now=$(relock "$sync_staged" $moving) || exit 1
  # `git commit <paths>` commits from an index of its own, next-index-<pid>.lock: what is staged
  # there is committed, and the index git keeps afterwards never hears of it.
  case "${GIT_INDEX_FILE:-}" in
    next-index-*.lock | */next-index-*.lock)
      [ -n "$moving" ] || die "$lock is not committed yet, and \`git commit <paths>\` commits from an index of its own, which this hook cannot stage it into." "Commit again with $lock among the paths: git commit <paths> $lock"
      sync_moves=""
      for sync_name in $moving; do sync_moves="$sync_moves, $sync_name $(short "$(pin_of "$sync_staged" "$sync_name")") -> $(short "$(pin_of "$sync_now" "$sync_name")")"; done
      # shellcheck disable=SC2086 # one word per sibling
      die "$lock must move (${sync_moves#, }), and \`git commit <paths>\` commits from an index of its own, which this hook cannot stage it into." \
        "sh .agents/siblings pin$moving" \
        "Then commit again with $lock among the paths: git commit <paths> $lock" \
        "Or leave the pins where they are: SIBLINGS_ALLOW_DRIFT=$(echo $moving | tr ' ' ',') git commit <paths>"
      ;;
  esac
  sync_current=$(lock_text)
  if [ "$sync_tracked" = yes ] && [ "$sync_current" != "$sync_staged" ] && [ "$sync_current" != "$sync_now" ]; then
    die "$lock has changes that are not staged, which pinning here would overwrite." "Stage them (git add $lock) or drop them (git restore $lock), then commit again."
  fi
  printf '%s\n' "$sync_now" >"$lock"
  git add -- "$lock"
  for sync_name in $moving; do move "$sync_name" "$(pin_of "$sync_staged" "$sync_name")" "$(pin_of "$sync_now" "$sync_name")"; done
  echo "$lock is staged: this commit pins the sibling commits it was tested against."
}

# row <label> <text>: a line of status.
row() { printf '  %-7s %s\n' "$1" "$2"; }

# status: each pin beside the HEAD of its sibling, whether the sibling has uncommitted work,
# whether a remote branch holds the pin and whether its sibling's CI ran on it. Reads only.
status() {
  status_text=$(lock_text)
  well_formed "$status_text" "$lock"
  if [ ! -f "$lock" ]; then
    echo "$lock is missing: no sibling is pinned yet (sh .agents/siblings pin)."
  elif [ -n "$(git --no-optional-locks status --porcelain -- "$lock" 2>/dev/null)" ]; then
    echo "$lock has changes not committed yet, and CI tests the committed one."
  fi
  for status_name in $siblings; do
    status_pin=$(pin_of "$status_text" "$status_name")
    echo ""
    echo "$status_name"
    if [ -z "$status_pin" ]; then
      row pin "none (sh .agents/siblings pin $status_name)"
    elif there "$status_name" && has "$status_name" "$status_pin"; then
      row pin "$(sib "$status_name" log --no-color -1 --format='%h %s' "$status_pin")"
    else
      row pin "$(short "$status_pin")"
    fi
    if ! there "$status_name"; then
      row HEAD "none here: ../$status_name is not checked out"
      continue
    fi
    status_at=$(head_of "$status_name") || status_at=""
    if [ -z "$status_at" ]; then
      row HEAD "none: ../$status_name has no commit"
    elif [ -z "$status_pin" ]; then
      row HEAD "$(short "$status_at"), not pinned"
    else
      compare "$status_name" "$status_pin" "$status_at"
      case $rel in
        same) row HEAD "at the pin" ;;
        ahead)
          row HEAD "$(short "$status_at"), $(count "$rel_n") ahead of the pin:"
          subjects "$status_name" "$status_pin..$status_at"
          ;;
        behind)
          row HEAD "$(short "$status_at"), $(count "$rel_n") behind the pin:"
          subjects "$status_name" "$status_at..$status_pin"
          ;;
        diverged) row HEAD "$(short "$status_at"), diverged from the pin: $(count "$rel_n") only here, $(count "$rel_back") only at the pin" ;;
        *) row HEAD "$(short "$status_at"), and ../$status_name does not have the pin (git -C ../$status_name fetch)" ;;
      esac
    fi
    if dirty "$status_name"; then row tree "uncommitted or untracked files"; else row tree clean; fi
    [ -n "$status_pin" ] || continue
    if ! has "$status_name" "$status_pin"; then
      row pushed "not known: ../$status_name does not have the pin"
    elif status_held=$(held "$status_name" "$status_pin") && [ -n "$status_held" ]; then
      row pushed "yes, on $status_held"
    else
      row pushed "no: no remote branch holds the pin, so CI could never fetch it"
    fi
    case " $bundled " in
      *" $status_name "*)
        ci_run "$status_name" "$status_pin"
        case $ci in
          none) row CI "never ran on the pin, so no bundle of it exists" ;;
          unknown) row CI "not checked: $ci_why" ;;
          *) row CI "$ci on the pin (run $ci_id)" ;;
        esac
        ;;
    esac
  done
}

# at_pins: before a release tags, each sibling is checked out, has no uncommitted or
# untracked files and has its HEAD at its pin, so the release tags what CI tested against those
# pins. Names every sibling that is not, and what to do, then exits 1. Reads only this machine.
at_pins() {
  [ -f "$lock" ] || die "$lock is missing, so CI cannot know which sibling commits to test against." "sh .agents/siblings pin, then commit $lock."
  at_text=$(lock_text)
  well_formed "$at_text" "$lock"
  at_off=""
  for at_name in $siblings; do
    at_pin=$(pin_of "$at_text" "$at_name")
    if [ -z "$at_pin" ]; then
      problem "$lock pins no commit for $at_name." "sh .agents/siblings pin $at_name, then commit $lock."
      at_off="$at_off $at_name"
      continue
    fi
    if ! there "$at_name"; then
      problem "../$at_name is not checked out, so whether it is at its pin $(short "$at_pin") is not known." "sh .agents/setup, then bring it to its pin: git -C ../$at_name switch --detach $at_pin"
      at_off="$at_off $at_name"
      continue
    fi
    at_head=$(head_of "$at_name") || at_head=""
    if [ "$at_head" != "$at_pin" ]; then
      at_bring="Bring it to its pin: git -C ../$at_name switch --detach $at_pin"
      at_move="Or pin it where it is, in a commit of its own: sh .agents/siblings pin $at_name && git add $lock && git commit"
      if [ -z "$at_head" ]; then
        problem "../$at_name has no commit, and its pin is $(short "$at_pin")." "$at_bring"
      else
        compare "$at_name" "$at_pin" "$at_head"
        case $rel in
          ahead) problem "../$at_name is at $(short "$at_head"), $(count "$rel_n") ahead of its pin $(short "$at_pin")." "$at_bring" "$at_move" ;;
          behind) problem "../$at_name is at $(short "$at_head"), $(count "$rel_n") behind its pin $(short "$at_pin")." "$at_bring" "$at_move" ;;
          diverged) problem "../$at_name is at $(short "$at_head"), which diverged from its pin $(short "$at_pin") ($(count "$rel_n") only here, $(count "$rel_back") only at the pin)." "$at_bring" "$at_move" ;;
          *) problem "../$at_name is at $(short "$at_head"), and does not have its pin $(short "$at_pin")." "git -C ../$at_name fetch, then bring it to its pin: git -C ../$at_name switch --detach $at_pin" ;;
        esac
      fi
      at_off="$at_off $at_name"
    fi
    if at_paths=$(changes "$at_name") && [ -n "$at_paths" ]; then
      problem "../$at_name has uncommitted or untracked files, so it is not what $lock pins:"
      listed "$at_paths"
      echo "  Commit them on a branch and push it, then pin it in a commit of its own: sh .agents/siblings pin $at_name" >&2
      echo "  Or set them aside, where they are not meant to ship: git -C ../$at_name stash --include-untracked" >&2
      case " $at_off " in *" $at_name "*) ;; *) at_off="$at_off $at_name" ;; esac
    fi
  done
  [ -z "$at_off" ] || exit 1
  echo "Every sibling is checked out clean at its pin."
}

# verify [<commit>...]: before a push, siblings.lock as each pushed commit holds it, or as the
# working tree holds it with no commit named. Exits 1 where a pin could never reach CI, or where a commit carries no lock, which CI's checkout stops on.
verify() {
  verify_blocked=no
  verify_seen=" "
  [ "$#" -gt 0 ] || set -- ""
  for verify_commit in "$@"; do
    if [ -z "$verify_commit" ]; then
      if [ ! -f "$lock" ]; then
        problem "$lock is missing, so CI cannot know which sibling commits to test against." "sh .agents/siblings pin"
        verify_blocked=yes
        continue
      fi
      verify_text=$(lock_text)
      verify_label=$lock
    elif ! verify_text=$(git show "$verify_commit:$lock" 2>/dev/null); then
      # CI checks each sibling out at the pin the pushed commit carries, and stops on a commit
      # that carries none: a clone whose hooks were never installed commits one.
      problem "$(short "$verify_commit") carries no $lock, so CI cannot know which sibling commits to test it against." "sh .agents/siblings pin, then commit $lock and push again."
      verify_blocked=yes
      continue
    else
      verify_label="$lock at $(short "$verify_commit")"
    fi
    well_formed "$verify_text" "$verify_label"
    pins_every "$verify_text" "$verify_label"
    for verify_name in $siblings; do
      verify_pin=$(pin_of "$verify_text" "$verify_name")
      case "$verify_seen" in *" $verify_name@$verify_pin "*) continue ;; esac
      verify_seen="$verify_seen$verify_name@$verify_pin "
      fetchable "$verify_name" "$verify_pin" || verify_blocked=yes
    done
  done
  [ "$verify_blocked" = no ] || exit 1
}

# fetchable <name> <commit>: says what stops <commit> reaching CI, and returns 1 where something does.
fetchable() {
  if ! there "$1"; then
    echo "../$1 is not checked out, so its pin $(short "$2") is not checked here."
    return 0
  fi
  if ! has "$1" "$2"; then
    warn "$1 is pinned at $(short "$2"), which ../$1 does not have, so whether a remote branch holds it is not checked." "git -C ../$1 fetch, then push again to check it."
  elif ! pushed "$1" "$2"; then
    problem "$1 is pinned at $(short "$2"), which no remote branch of ../$1 holds, so CI could never fetch it." "git -C ../$1 push origin $2:refs/heads/<branch>   (any branch will do), then push again."
    return 1
  fi
  case " $bundled " in *" $1 "*) ;; *) return 0 ;; esac
  ci_run "$1" "$2"
  case $ci in
    finished) ;;
    queued | running) warn "$1 is pinned at $(short "$2"), where its CI is $ci (run $ci_id). CI's checkout here waits for the bundle that run publishes." ;;
    failed | cancelled)
      warn "$1 is pinned at $(short "$2"), where its CI $ci (run $ci_id)." \
        "Its first step publishes the bundle, so CI here can almost certainly fetch it still. Read the run: depot ci logs $ci_id"
      ;;
    none)
      problem "$1 is pinned at $(short "$2"), which its CI never ran on, so no bundle of it exists for CI here to fetch." \
        "Pushed a moment ago? Wait for its run to start, then push again." \
        "Else push it to a branch of its own, which runs its CI: git -C ../$1 push origin $2:refs/heads/<branch>" \
        "Or pin a commit its CI ran on: sh .agents/siblings pin $1"
      return 1
      ;;
    unknown) warn "$1 is pinned at $(short "$2"), and whether its CI ran there is not checked: $ci_why." ;;
    *) warn "$1 is pinned at $(short "$2"), where its CI run is $ci (run $ci_id)." ;;
  esac
  return 0
}

# ci_run <name> <commit>: the latest CI run of ../<name> on <commit>, as Depot lists it. $ci is its
# status (queued, running, finished, failed or cancelled) and $ci_id its id; or $ci is none where
# its CI never ran on <commit>, or unknown where Depot cannot say, and $ci_why says why.
ci_run() {
  ci=unknown
  ci_id=""
  ci_why=""
  ci_url=$(sib "$1" remote get-url origin 2>/dev/null) || ci_url=""
  case "$ci_url" in
    */et/*/*) ci_repo="et/${ci_url#*/et/}" ;;
    *)
      ci_why="../$1 has no origin on Entire to look its CI up by"
      return 0
      ;;
  esac
  ci_repo=${ci_repo%/}
  ci_repo=${ci_repo%.git}
  ci_depot=$(command -v depot 2>/dev/null) || ci_depot=$(mise which depot 2>/dev/null) || ci_depot=""
  if [ -z "$ci_depot" ]; then
    ci_why="depot is not installed (mise.toml pins it: mise install)"
    return 0
  fi
  # Every status: with none named, depot lists queued and running runs alone.
  if ! ci_out=$("$ci_depot" ci run list --repo "$ci_repo" --sha "$2" --status queued --status running --status finished --status failed --status cancelled -n 50 --output json </dev/null 2>&1); then
    ci_why="depot cannot list its CI runs: $(printf '%s\n' "$ci_out" | sed -n 1p)"
    return 0
  fi
  # Depot lists a run for each push, the latest first, and others on the same commit (a tag's push,
  # which runs mirror.yml alone, `depot ci run` on uncommitted work, a schedule) that publish no
  # bundle: CI's is the latest one a push of a branch started. Then one key and its value a line,
  # whether depot prints its JSON over many lines or one.
  ci_out=$(printf '%s\n' "$ci_out" | awk 'BEGIN { RS = "}" } /"ref": *"refs\/heads\// && /"trigger": *"push"/ { print; exit }' | tr ',{' '\n\n')
  ci=$(printf '%s\n' "$ci_out" | sed -n 's/^[[:space:]]*"status":[[:space:]]*"\([a-z_]*\)".*/\1/p' | sed -n 1p)
  ci_id=$(printf '%s\n' "$ci_out" | sed -n 's/^[[:space:]]*"run_id":[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n 1p)
  [ -n "$ci" ] || ci=none
}


# The registry, logged in to once per job with the token Depot CI injects.
registry() {
  [ -n "${SIBLINGS_REGISTRY:-}" ] || die "SIBLINGS_REGISTRY is not set: the Depot CI variable naming where the sibling bundles are." "depot ci vars add SIBLINGS_REGISTRY --value '<org-id>.registry.depot.dev/siblings'"
  [ -n "${DEPOT_TOKEN:-}" ] || die "DEPOT_TOKEN is not set: only a Depot CI job reaches the bundles, with the token it injects."
  command -v oras >/dev/null 2>&1 || die "oras is not on PATH. mise.toml pins it." "mise install"
  [ -z "${logged_in:-}" ] || return 0
  printf '%s' "$DEPOT_TOKEN" | oras login --username x-token --password-stdin "${SIBLINGS_REGISTRY%%/*}" >/dev/null
  logged_in=1
}

# ../<name> at <commit>, from the bundle its own CI published, with origin/main where its main is now.
# A bundle its CI has not published yet is waited for, SIBLINGS_WAIT_SECONDS at most, polling
# every 15 seconds.
fetch_bundle() {
  registry
  # Inside the clone, as for publish: mise's shim resolves oras from here.
  work="$(git rev-parse --absolute-git-dir)/mountaya/siblings/$1"
  rm -rf "$work"
  mkdir -p "$work"
  fetched=no
  if out=$(oras pull --output "$work/at" "$SIBLINGS_REGISTRY/$1:$2" 2>&1); then fetched=yes; fi
  waited=0
  if [ "$fetched" = no ]; then
    limit=${SIBLINGS_WAIT_SECONDS:-600}
    case "$limit" in '' | *[!0-9]*) die "SIBLINGS_WAIT_SECONDS is $limit: it must be a number of seconds." ;; esac
    [ "$limit" -eq 0 ] || printf 'No bundle of %s at %s yet: waiting up to %ss for its CI to publish it.\n' "$1" "$2" "$limit"
    while [ "$waited" -lt "$limit" ]; do
      step=15
      [ $((limit - waited)) -ge 15 ] || step=$((limit - waited))
      sleep "$step"
      waited=$((waited + step))
      if oras manifest fetch "$SIBLINGS_REGISTRY/$1:$2" >/dev/null 2>&1 && out=$(oras pull --output "$work/at" "$SIBLINGS_REGISTRY/$1:$2" 2>&1); then
        fetched=yes
        break
      fi
      printf '  none after %ss\n' "$waited"
    done
  fi
  if [ "$fetched" = no ]; then
    printf '%s\n' "$out" >&2
    waited_for=""
    [ "$waited" -eq 0 ] || waited_for=", after ${waited}s of waiting for one"
    die "The registry holds no bundle of $1 at $2${waited_for:-}." "$1's CI publishes one as the first step of every run: re-run its CI on $2, or re-pin $1 at a commit its CI ran on (sh .agents/siblings pin $1)."
  fi
  if ! out=$(oras pull --output "$work/main" "$SIBLINGS_REGISTRY/$1:main" 2>&1); then
    printf '%s\n' "$out" >&2
    die "The registry holds no bundle of $1's main." "$1's CI publishes it on every push of main: re-run its last run on main."
  fi
  git -c init.defaultBranch=main init --quiet "../$1"
  git -C "../$1" fetch --quiet "$work/at/$1.bundle" HEAD '+refs/remotes/origin/*:refs/remotes/origin/*'
  git -C "../$1" fetch --quiet "$work/main/$1.bundle" '+refs/remotes/origin/main:refs/remotes/origin/main'
  rm -rf "$work"
}

checkout() {
  check
  for name in $siblings; do
    [ ! -e "../$name" ] || die "../$name already exists, and checkout never overwrites one."
    commit=$(pin_of "$(lock_text)" "$name")
    printf '%s at %s\n' "$name" "$commit"
    case " $github " in
      *" $name "*) git clone --quiet --no-checkout 'https://github.com/mountaya'/"$name.git" "../$name" ;;
      *) fetch_bundle "$name" "$commit" ;;
    esac
    git -C "../$name" checkout --quiet --detach "$commit"
  done
}

# --- impact and gate: what the work checked out beside this repository reaches -------------------

workspace='ai schemas sdk-typescript sdk-kotlin sdk-swift sdk-dart helix.go platform atlas website gtm'
here='sdk-swift'

# ws_dir <name>: where <name> is checked out: this clone for its own name, else beside the main
# worktree of this one, so a linked worktree (an agent's, under .claude/worktrees/) finds them too.
ws_base=$(dirname "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")")
ws_dir() { if [ "$1" = "$here" ]; then echo .; else echo "$ws_base/$1"; fi; }
ws_there() { [ -e "$(ws_dir "$1")/.git" ]; }
# ws_git <name> <git args...>: git in that clone, with none of the GIT_* variables a hook sets.
ws_git() {
  ws_git_dir=$(ws_dir "$1")
  shift
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX
    git --no-pager -C "$ws_git_dir" "$@"
  )
}
# ws_pins <name>: each "<sibling> <commit>" the siblings.lock of <name> pins, and ws_reads the siblings alone.
ws_pins() {
  ws_pins_file="$(ws_dir "$1")/siblings.lock"
  [ ! -f "$ws_pins_file" ] || awk '!/^#/ && NF == 2 { print $1, $2 }' "$ws_pins_file"
}
ws_reads() { ws_pins "$1" | awk '{ print $1 }'; }
ws_plural() { if [ "$1" = 1 ]; then echo "1 $2"; else echo "$1 $2s"; fi; }
# ws_task <name> <task>: whether the mise.toml of <name> declares the task.
ws_task() { [ -f "$(ws_dir "$1")/mise.toml" ] && grep -Eq "^\[tasks\.(\"$2\"|$2)\][[:space:]]*$" "$(ws_dir "$1")/mise.toml"; }
# ws_note <name> <why>: one reason <name> is reached, written once. ws_mark <name> <list> adds it to
# the list, once, and ws_has <name> <list> says whether the list holds it.
ws_note() { grep -qxF -- "$2" "$ws_tmp/$1" 2>/dev/null || printf '%s\n' "$2" >>"$ws_tmp/$1"; }
ws_mark() { grep -qxF -- "$1" "$ws_tmp/.$2" 2>/dev/null || printf '%s\n' "$1" >>"$ws_tmp/.$2"; }
ws_has() { grep -qxF -- "$1" "$ws_tmp/.$2" 2>/dev/null; }

# ws_scan: what the work checked out here reaches, into $ws_tmp. A repository is changed where it
# has uncommitted or untracked files, commits its upstream branch lacks, or a HEAD other than the
# commit a repository reading it pins (.changed). It reaches every repository that reads it, and
# a change to ai every repository ai renders (.reached), in the order their pins give (.order).
# .missing lists those not checked out beside this one.
ws_scan() {
  ws_tmp=$(mktemp -d)
  trap 'rm -rf "$ws_tmp"' EXIT
  : >"$ws_tmp/.changed"
  : >"$ws_tmp/.missing"
  : >"$ws_tmp/.order"
  for name in $workspace; do
    if ! ws_there "$name"; then
      echo "$name" >>"$ws_tmp/.missing"
      continue
    fi
    n=$(ws_git "$name" --no-optional-locks status --porcelain --untracked-files=normal 2>/dev/null | wc -l | tr -d ' ')
    if [ "$n" -gt 0 ]; then
      ws_note "$name" "$(ws_plural "$n" file) uncommitted or untracked"
      ws_mark "$name" changed
    fi
    if upstream=$(ws_git "$name" rev-parse -q --verify '@{upstream}' 2>/dev/null); then
      n=$(ws_git "$name" rev-list --count "$upstream..HEAD" 2>/dev/null) || n=0
      if [ "$n" -gt 0 ]; then
        ws_note "$name" "$(ws_plural "$n" commit) its upstream branch lacks"
        ws_mark "$name" changed
      fi
    fi
  done
  for reader in $workspace; do
    ws_there "$reader" || continue
    ws_pins "$reader" >"$ws_tmp/.pins"
    while read -r name pin; do
      ws_there "$name" || continue
      at=$(ws_git "$name" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null) || continue
      [ "$at" != "$pin" ] || continue
      ws_note "$name" "HEAD is not the commit $reader pins ($(printf '%s' "$pin" | cut -c1-7))"
      ws_mark "$name" changed
    done <"$ws_tmp/.pins"
  done
  cp "$ws_tmp/.changed" "$ws_tmp/.reached"
  # ai renders every repository with a manifest, whether that one pins ai or not.
  if ws_has ai changed; then
    for name in $workspace; do
      if [ "$name" != ai ] && ws_there "$name" && [ -f "$(ws_dir "$name")/.agents/manifest.json" ]; then
        ws_note "$name" "rendered from ai"
        ws_mark "$name" reached
      fi
    done
  fi
  grew=yes
  while [ "$grew" = yes ]; do
    grew=no
    for reader in $workspace; do
      ws_there "$reader" || continue
      for name in $(ws_reads "$reader"); do
        ws_has "$name" reached || continue
        ws_note "$reader" "reads $name"
        if ! ws_has "$reader" reached; then
          ws_mark "$reader" reached
          grew=yes
        fi
      done
    done
  done
  left=""
  for name in $workspace; do
    if ws_has "$name" reached; then left="$left $name"; fi
  done
  while [ -n "$left" ]; do
    rest=""
    placed=no
    for name in $left; do
      ready=yes
      for sibling in $(ws_reads "$name"); do
        if ws_has "$sibling" reached && ! ws_has "$sibling" order; then ready=no; fi
      done
      if [ "$ready" = yes ]; then
        ws_mark "$name" order
        placed=yes
      else
        rest="$rest $name"
      fi
    done
    # Pins that read each other in a circle: the rest goes in the workspace's order.
    if [ "$placed" = no ]; then
      for name in $rest; do ws_mark "$name" order; done
      break
    fi
    left=$rest
  done
}

impact() {
  ws_scan
  if [ -s "$ws_tmp/.order" ]; then
    echo "Reached, in the order gate checks them:"
    while read -r name; do
      printf '  %-16s %s\n' "$name" "$(paste -s -d ';' "$ws_tmp/$name" | sed 's/;/; /g')"
    done <"$ws_tmp/.order"
  else
    echo "No repository checked out beside this one has work the others have not seen: nothing is reached."
  fi
  if [ -s "$ws_tmp/.missing" ]; then echo "Not checked out beside this one, so not looked at: $(paste -s -d ' ' "$ws_tmp/.missing")."; fi
}

# ws_locked: stops while a release runs from a repository checked out beside this one, whose suites
# gate would compete with for the machine. A lock whose process is gone is said and passed over.
ws_locked() {
  for name in $workspace; do
    ws_there "$name" || continue
    lock_dir=$(ws_git "$name" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || continue
    [ -f "$lock_dir/mountaya/release.lock" ] || continue
    pid=$(sed -n 's/^pid=//p' "$lock_dir/mountaya/release.lock")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      die "A release is running from ../$name (process $pid), and gate would compete with it for this machine." "Run gate again once the release is done."
    fi
    printf '! %s names a release that no longer runs: gate goes on.\n' "$lock_dir/mountaya/release.lock" >&2
  done
}

# ws_check <name> <label> <command...>: one check gate runs in the clone of <name>. Its output goes
# to a log, whose last lines are shown where it fails.
ws_check() {
  ws_check_name=$1
  ws_check_label=$2
  shift 2
  ws_check_log="$ws_logs/$ws_check_name.$(printf '%s' "$ws_check_label" | tr -c 'A-Za-z0-9._-' '_').log"
  if (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX
    cd "$(ws_dir "$ws_check_name")" && "$@"
  ) >"$ws_check_log" 2>&1 </dev/null; then
    printf '✓ %-16s %s\n' "$ws_check_name" "$ws_check_label"
  else
    printf '✗ %-16s %s, the last lines of %s:\n' "$ws_check_name" "$ws_check_label" "$ws_check_log"
    tail -n 15 "$ws_check_log" | sed 's/^/    /'
    ws_failed=$((ws_failed + 1))
  fi
}

gate() {
  ws_locked
  ws_scan
  if [ ! -s "$ws_tmp/.order" ]; then
    echo "No repository checked out beside this one has work the others have not seen: nothing to check."
    return 0
  fi
  ws_logs="$(git rev-parse --path-format=absolute --git-common-dir)/mountaya/gate"
  rm -rf "$ws_logs"
  mkdir -p "$ws_logs"
  ws_failed=0
  # ai as an absolute path, which each check reaches from the clone it runs in.
  ws_ai=$(cd "$(ws_dir ai)" 2>/dev/null && pwd) || ws_ai=""
  for name in $(cat "$ws_tmp/.order"); do
    if ws_task "$name" ci:quick; then
      ws_check "$name" "mise run ci:quick" mise run ci:quick
    else
      printf '! %-16s declares no ci:quick task, so nothing of its gate is checked\n' "$name"
    fi
    if ws_has ai changed && [ -f "$(ws_dir "$name")/.agents/manifest.json" ]; then
      ws_check "$name" "the render of ai (apply.mjs --check)" mise exec -- node "$ws_ai/scripts/apply.mjs" --check .
    fi
    for sibling in $(ws_reads "$name"); do
      ws_has "$sibling" reached || continue
      if ws_task "$name" generate:check; then ws_check "$name" "mise run generate:check" mise run generate:check; fi
      break
    done
  done
  if [ "$ws_failed" -gt 0 ]; then die "$(ws_plural "$ws_failed" check) of gate failed." "Fix each one, then run gate again."; fi
  echo "Every repository the work reaches passes."
}

case "${1:-}" in
  pin) shift; pin "$@" ;;
  check) check ;;
  status) status ;;
  sync) sync_lock ;;
  verify) shift; verify "$@" ;;
  at-pins) at_pins ;;
  checkout) checkout ;;
  impact) impact ;;
  gate) gate ;;
  -h | --help) sed -n '2,/^set -eu$/p' "$0" | sed -n 's/^# \{0,1\}//p' ;;
  *) die "Usage: sh .agents/siblings pin [<repository>...] | check | status | sync | verify [<commit>...] | at-pins | checkout | impact | gate" ;;
esac
