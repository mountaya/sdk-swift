#!/bin/sh
# Generated by mountaya/ai (scripts/apply.mjs). Edit .agents/manifest.json instead.
#
# Formatting and linting, on every commit: `mise run ci:quick`. Tests and the build
# are the gate, `mise run ci`, of which CI runs only part on every push
# (.depot/workflows/ci.yml): run the gate before you push.
# Before that check, `sh .agents/siblings sync` stops the commit while any sibling checked out
# beside this one has uncommitted or untracked files or a HEAD no remote branch holds, naming
# each one and what to do; SIBLINGS_ALLOW_DRIFT never lifts that. It then pins in siblings.lock
# each sibling whose HEAD moved forward, and stages the lock, so a commit pins the sibling
# commits it was tested against. It stops on a HEAD behind or diverged from its pin; it keeps
# every pin of a commit that changes siblings.lock itself or concludes a merge; and
# SIBLINGS_ALLOW_DRIFT=<name>[,<name>] leaves a pin where it is.
# .git/hooks/pre-commit runs this file once `sh .githooks/install` has wired it; Entire
# never uses that hook. `git commit --no-verify` skips it.
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! command -v mise >/dev/null 2>&1; then
  printf '[pre-commit] mise is not installed, and the checks run on the toolchain mise.toml pins: run `sh .agents/setup`.\n' >&2
  exit 1
fi

sh .agents/siblings sync </dev/null || {
  printf '[pre-commit] the sibling check above stopped this commit, so nothing was committed.\n' >&2
  exit 1
}

# Its stdin is closed, so nothing it runs waits on the terminal.
mise run ci:quick </dev/null || {
  printf '[pre-commit] a check failed, so nothing was committed.\n' >&2
  exit 1
}
