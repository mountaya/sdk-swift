#!/bin/sh
# Generated by mountaya/ai (scripts/apply.mjs). Edit .agents/manifest.json instead.
#
# Wires .githooks/ into this clone's git hooks. `sh .agents/setup` and
# `node ../ai/scripts/apply.mjs` run it whenever the hooks are missing; by hand:
# sh .githooks/install
#
# It never sets core.hooksPath. Entire keeps its own hooks in .git/hooks, chains
# a hook it finds there as <hook>.pre-entire (its own runs first), and records
# nothing once git looks for hooks anywhere else. Its Brain plugin chains pre-push
# the same way, as <hook>.pre-entire-brain.
#
# It removes the pre-push hooks no hook of that chain runs any more, where each was
# Entire's, Brain's or its own; a hook none of them wrote stays where it is.
set -eu
top=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '%s\n' 'Not in a git work tree: .githooks/install wires the hooks of a clone.' >&2; exit 1; }
cd "$top"
hooks="$(git rev-parse --git-common-dir)/hooks"
mkdir -p "$hooks"
resolved=$(git rev-parse --git-path hooks)
if [ ! -d "$resolved" ] || [ "$(cd "$resolved" && pwd -P)" != "$(cd "$hooks" && pwd -P)" ]; then
  printf 'core.hooksPath sends git to %s, where neither these hooks nor Entire'"'"'s run. Unset it with `git config --unset core.hooksPath` and run this again.\n' "$resolved" >&2
  exit 1
fi

mark='mountaya-ai git hook'
ours() { [ -f "$1" ] && grep -q "$mark" "$1"; }
entires() { [ -f "$1" ] && grep -q '# Entire CLI hooks' "$1"; }
refuse() {
  printf '%s holds a hook this script did not write. Move it aside or merge it by hand, then run this again.\n' "$1" >&2
  exit 1
}

# stub <script in .githooks/> <hook file>
stub() {
  cat >"$2" <<EOF
#!/bin/sh
# $mark: installed by .githooks/install, runs .githooks/$1
MOUNTAYA_HOOK_NAME=\$(basename "\$0")
export MOUNTAYA_HOOK_NAME
exec sh "\$(git rev-parse --show-toplevel)/.githooks/$1" "\$@"
EOF
  chmod +x "$2"
  printf 'installed %s\n' "$2"
}

# Entire never uses pre-commit.
if [ -f "$hooks/pre-commit" ] && ! ours "$hooks/pre-commit"; then refuse "$hooks/pre-commit"; fi
stub pre-commit "$hooks/pre-commit"

# What an earlier version installed: a post-push run from reference-transaction, and the
# stamps and log it kept. No hook runs the gate after a push any more, so they go.
# shellcheck disable=SC2043 # one hook today, and the list is where the next one goes
for old in reference-transaction; do
  if ours "$hooks/$old"; then rm -f "$hooks/$old" && printf 'removed %s\n' "$hooks/$old"; fi
done
state="$(git rev-parse --git-common-dir)/mountaya"
rm -rf "$state/ci" "$state/pushing" "$state/post-push.log"

# Entire owns pre-push, and its Brain plugin chains itself in too, each moving aside what
# it finds, in whichever order they ran: Entire's hook runs pre-push.pre-entire beside it,
# Brain's runs <itself>.pre-entire-brain. This hook goes at the end of that chain. With
# nothing to chain it, it takes pre-push itself and runs Entire's step there, and Entire
# chains it on its next agent session or `entire enable`.
brains() { [ -f "$1" ] && grep -q '# entire-brain push hook' "$1"; }
at="$hooks/pre-push"
seen=" "
while [ -f "$at" ] && ! ours "$at"; do
  case "$seen" in *" $at "*) refuse "$at" ;; esac
  seen="$seen$at "
  if entires "$at" && grep -q "pre-push.pre-entire" "$at"; then
    at="$hooks/pre-push.pre-entire"
  elif brains "$at"; then
    at="$at.pre-entire-brain"
  elif entires "$at" && [ "$at" = "$hooks/pre-push" ]; then
    break
  elif entires "$at"; then
    printf '%s is Entire'"'"'s hook, chaining nothing after it. Run `entire enable`, which rewrites it, then this again.\n' "$at" >&2
    exit 1
  else
    refuse "$at"
  fi
done
stub pre-push "$at"
# What no hook of the chain runs any more: copies of this hook a rechaining left, and
# Entire's or Brain's own hooks moved aside where nothing chains them. A hook none of
# them wrote stays.
chain="$seen$at "
for old in "$hooks"/pre-push.*; do
  case "$chain" in *" $old "*) continue ;; esac
  if ours "$old" || entires "$old" || brains "$old"; then
    rm -f "$old"
    printf 'removed %s\n' "$old"
  fi
done
