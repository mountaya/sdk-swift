#!/bin/sh
# Generated by mountaya/ai (scripts/apply.mjs). Edit .agents/manifest.json instead.
#
# Never runs the gate. CI runs part of it once the push lands (.depot/workflows/ci.yml), and the
# whole gate, `mise run ci`, runs only where you work: run it before you push.
# It stops a push only where a pushed commit carries no siblings.lock, or one that pins a
# sibling commit CI could never fetch: one no remote branch holds, or one its sibling's CI
# never ran on, so no bundle of it exists (`sh .agents/siblings verify`).
# .git/hooks/pre-push runs this file, directly or chained by Entire as
# pre-push.pre-entire; `sh .githooks/install` sets that up. `git push --no-verify` skips it.
# Arguments: <remote> <url>. Stdin: a line per pushed ref, <local ref> <local commit>
# <remote ref> <remote commit>, which Entire's step leaves in place and this one hands on.
# Where a hook before this one read them, each local branch ahead of its upstream stands for
# them, and the hook says so.
# No set -e: a failure here never stops the push; only a missing lock or a pin CI could never fetch does.
cd "$(git rev-parse --show-toplevel)" || exit 0

zero=0000000000000000000000000000000000000000
# What a push may send, where git's list of pushed refs is not there to read: each local branch
# ahead of its upstream, pushed to the branch it tracks; the current branch where it tracks none;
# and HEAD where it is detached.
local_refs() {
  current=$(git symbolic-ref -q HEAD) || current=""
  git for-each-ref --format='%(refname)%09%(objectname)%09%(upstream:remoteref)%09%(upstream)%09%(upstream:track)' refs/heads/ |
    awk -F '\t' -v current="$current" '$3 != "" && $5 ~ /ahead/ { print $1, $2, $3, $4; next } $1 == current && $3 == "" { print $1, $2, $1, "-" }' |
    while read -r ref sha remote_ref upstream; do
      base=$zero
      [ "$upstream" = - ] || base=$(git rev-parse -q --verify "$upstream") || base=$zero
      printf '%s %s %s %s\n' "$ref" "$sha" "$remote_ref" "$base"
    done
  if [ -z "$current" ] && head=$(git rev-parse -q --verify HEAD); then printf 'HEAD %s HEAD %s\n' "$head" "$zero"; fi
}
# The pushed refs, as git writes them on stdin. As .git/hooks/pre-push itself, this file reads
# them from git alone, and none means nothing is pushed. At the end of the chain Entire and Brain
# build, a hook before it could read them first: there, and run by hand, local_refs stands for
# an empty list, and the hook says so.
if [ -t 0 ]; then pushed=""; else pushed=$(cat); fi
refs=$pushed
if [ -z "$refs" ] && [ "${MOUNTAYA_HOOK_NAME:-}" != pre-push ]; then
  refs=$(local_refs)
  [ -z "$refs" ] || printf '[pre-push] The refs this push sends did not reach this hook, so each local branch ahead of its upstream stands for them.\n' >&2
fi

# siblings.lock, as each pushed commit holds it.
commits=$(printf '%s\n' "$refs" | awk 'NF >= 2 && $2 ~ /[1-9a-f]/ { print $2 }' | sort -u)
# shellcheck disable=SC2086 # one word per commit
if [ -n "$commits" ] && ! sh .agents/siblings verify $commits </dev/null; then
  printf '[pre-push] the sibling check above stopped this push, so nothing was pushed. `git push --no-verify` pushes anyway.\n' >&2
  exit 1
fi

# Installed in place of Entire's own pre-push, this hook runs Entire's step itself
# until Entire chains it, on the next agent session or `entire enable`.
if [ "${MOUNTAYA_HOOK_NAME:-}" = pre-push ] && [ -f .entire/settings.json ] && command -v entire >/dev/null 2>&1; then
  # With the pushed refs on its stdin, as git wrote them.
  if [ -n "$pushed" ]; then printf '%s\n' "$pushed"; fi | entire hooks git pre-push "${1:-origin}"
  exit $?
fi
exit 0
