                }
              ]
            }
          }
        ]
      },
      {
        "name": "Thing",
        "kind": "object",
        "usage": ["response"],
        "unit": "core",
        "description": "A thing, as the API returns it.",
        "properties": [
          { "name": "id", "required": true, "type": { "kind": "string", "format": "uuid" }, "description": "Its identifier.", "readOnly": true },
          { "name": "created_at", "required": true, "type": { "kind": "string", "format": "date-time" } },
          { "name": "updated_at", "required": false, "type": { "kind": "string", "format": "date-time", "nullable": true } },
          { "name": "website", "required": false, "type": { "kind": "string", "format": "uri" } },
          { "name": "count", "required": true, "type": { "kind": "integer", "format": "int64" } },
          { "name": "ratio", "required": false, "type": { "kind": "number", "format": "double" } },
          { "name": "tags", "required": true, "type": { "kind": "array", "items": { "kind": "string" } } },
          { "name": "stamps", "required": false, "type": { "kind": "array", "items": { "kind": "string", "format": "date-time" } } },
          { "name": "names", "required": false, "type": { "kind": "ref", "name": "Names" } },
          { "name": "extras", "required": false, "type": { "kind": "any" } },
          { "name": "kind", "required": true, "type": { "kind": "ref", "name": "ThingKind" } },
          { "name": "size", "required": false, "type": { "kind": "ref", "name": "TileSize" } },
          { "name": "point", "required": false, "type": { "kind": "ref", "name": "GeoPoint", "nullable": true } },
          { "name": "meta", "required": false, "type": { "kind": "object", "name": "ThingMeta", "properties": [{ "name": "source", "required": true, "type": { "kind": "string" } }] } },
          { "name": "choice", "required": false, "type": { "kind": "union", "name": "ThingChoice", "members": [{ "kind": "string" }, { "kind": "integer" }] } },
          { "name": "level", "required": false, "type": { "kind": "string", "name": "ThingLevel", "enum": ["LOW", "HIGH"] } },
          { "name": "fixed", "required": true, "type": { "kind": "string", "const": "thing" } },
          { "name": "flags", "required": false, "type": { "kind": "map", "keys": { "kind": "ref", "name": "ThingKind" }, "values": { "kind": "boolean" } } },
          { "name": "old", "required": false, "type": { "kind": "string" }, "deprecated": true, "description": "The former name. Use `names` instead." },
          { "name": "default", "required": false, "type": { "kind": "boolean" } }
        ]
      },
      {
        "name": "ThingCreate",
        "kind": "object",
        "usage": ["request"],
