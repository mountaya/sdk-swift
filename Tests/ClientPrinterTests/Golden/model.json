        "name": "ThingKind",
        "kind": "enum",
        "usage": ["request", "response"],
        "unit": "core",
        "description": "What kind a thing is.",
        "valueType": "string",
        "members": [
          { "value": "small-one", "name": "ThingKindSmallOne", "description": "A small one." },
          { "value": "big", "name": "ThingKindBig", "deprecated": true, "description": "A big one. Retired: every big thing is now two small ones." },
          { "value": "2xl", "name": "ThingKind2xl", "description": "An extra-large one." }
        ]
      },
      {
        "name": "ThingPatch",
        "kind": "object",
        "usage": ["request"],
        "unit": "core",
        "closed": true,
        "properties": [
          { "name": "name", "required": false, "type": { "kind": "string", "nullable": true } },
          { "name": "when", "required": false, "type": { "kind": "string", "format": "date-time", "nullable": true } },
          { "name": "note", "required": false, "type": { "kind": "string" } }
        ]
      },
      {
        "name": "ThingScope",
        "kind": "enum",
        "usage": ["request", "response"],
        "unit": "core",
        "description": "What a key reaches.",
        "valueType": "string",
        "members": [
          { "value": "read", "name": "ThingScopeRead", "description": "Reads." },
          { "value": "write", "name": "ThingScopeWrite", "description": "Writes.", "includes": ["read"], "needs": ["audit", "tiles"] },
          { "value": "audit", "name": "ThingScopeAudit", "description": "Audits." },
          { "value": "internal", "name": "ThingScopeInternal", "description": "Reaches what only Mountaya reaches." }
        ]
      },
      {
        "name": "TileSize",
        "kind": "enum",
        "usage": ["response"],
        "unit": "core",
        "valueType": "integer",
        "format": "int32",
        "members": [
          { "value": 256, "name": "TileSize256" },
          { "value": 512, "name": "TileSize512" }
        ]
      },
      {
        "name": "WebhookEvent",
        "kind": "object",
        "usage": ["response"],
        "unit": "admin",
        "description": "A change recorded, as it is delivered to an endpoint.",
        "properties": [
          { "name": "id", "required": true, "type": { "kind": "string", "format": "uuid" }, "description": "Identifier of the event." },
          { "name": "object", "required": true, "type": { "kind": "string", "const": "webhook_event" }, "description": "Always `webhook_event`." },
          { "name": "type", "required": true, "type": { "kind": "ref", "name": "WebhookEventType" }, "description": "What happened." },
          { "name": "created_at", "required": true, "type": { "kind": "string", "format": "date-time" }, "description": "When the change was made." },
          { "name": "data", "required": true, "type": { "kind": "ref", "name": "WebhookEventData" }, "description": "The object, and what the change moved." },
          { "name": "request_id", "required": true, "type": { "kind": "string", "nullable": true }, "description": "The request that made the change, null for a change made on its own." },
          { "name": "livemode", "required": false, "type": { "kind": "boolean" }, "description": "Whether the change was made in a live organization." },
          { "name": "legacy_id", "required": false, "type": { "kind": "string" }, "deprecated": true, "description": "The former identifier of the event. Use `id` instead." }
        ]
      },
      {
        "name": "WebhookEventData",
        "kind": "object",
        "usage": ["response"],
        "unit": "admin",
        "description": "What a webhook event says about its object.",
        "properties": [
          { "name": "object", "required": true, "type": { "kind": "ref", "name": "WebhookEventObject" }, "description": "The object once the change was made." },
          { "name": "previous_attributes", "required": false, "type": { "kind": "map", "values": { "kind": "any" } }, "description": "The fields of `data.object` the change moved, each with the value it held before." }
        ]
      },
      {
        "name": "ThingEventObject",
        "kind": "object",
        "usage": ["response"],
        "unit": "admin",
        "description": "A thing as a webhook event carries it.",
        "properties": [
          { "name": "object", "required": true, "type": { "kind": "string", "const": "thing" }, "discriminatorValue": "thing", "description": "Always `thing`." },
          { "name": "id", "required": true, "type": { "kind": "string", "format": "uuid" }, "description": "Its identifier." },
          { "name": "count", "required": true, "type": { "kind": "integer", "format": "int64" } },
          { "name": "updated_at", "required": true, "type": { "kind": "string", "format": "date-time", "nullable": true } },
          { "name": "kind", "required": true, "type": { "kind": "ref", "name": "ThingKind" } },
          { "name": "old", "required": false, "type": { "kind": "string" }, "deprecated": true, "description": "The former name. Use `names` instead." }
        ]
      },
      {
        "name": "WebhookEventObject",
        "kind": "union",
        "usage": ["response"],
        "unit": "admin",
        "description": "The object a webhook event carries, told apart by its `object`.",
        "discriminator": "object",
        "members": [{ "value": "thing", "type": "ThingEventObject" }]
      },
      {
        "name": "WebhookEventType",
        "kind": "enum",
        "usage": ["request", "response"],
        "unit": "admin",
        "description": "What happened.",
        "valueType": "string",
        "members": [
          { "value": "thing.created", "name": "WebhookEventTypeThingCreated" },
          { "value": "thing.updated", "name": "WebhookEventTypeThingUpdated" }
        ]
      }
    ],
