  "data": {
    "origin": "https://data.example.com",
    "endpoint": "/graphql",
    "operations": [
      {
        "name": "lookup",
        "input": "LookupInput",
        "inputType": "LookupInput!",
        "resultType": "LookupResult",
        "scopes": ["DATA"],
        "timeoutMs": 30000,
        "credentials": {
          "actingUser": "none",
          "acceptsShareToken": false,
          "requiresSession": true,
          "requiresSecretKey": false,
          "takesNoCredential": false,
          "pendingInvitee": false
        },
        "success": { "responses": [{ "status": 200, "headers": [] }] },
        "selection": [
          { "name": "items", "fields": [{ "name": "name" }, { "name": "when" }] },
          { "name": "total" }
        ],
        "document": "query Lookup($input: LookupInput!) {\n  lookup(input: $input) {\n    items {\n      name\n      when\n    }\n    total\n  }\n}\n",
        "description": "Looks things up."
      }
    ],
    "objects": [
      {
        "name": "LookupItem",
        "fields": [
          { "name": "name", "type": { "kind": "ref", "name": "String", "nullable": true } },
          { "name": "when", "type": { "kind": "ref", "name": "DateTime", "nullable": true } },
          { "name": "where", "type": { "kind": "ref", "name": "GeoJSON", "nullable": true } },
          { "name": "link", "type": { "kind": "ref", "name": "URL" } },
          { "name": "id", "type": { "kind": "ref", "name": "ID" } },
          { "name": "score", "type": { "kind": "ref", "name": "Float" } },
          { "name": "ok", "type": { "kind": "ref", "name": "Boolean" } },
          { "name": "kind", "type": { "kind": "ref", "name": "LookupKind" }, "deprecated": true }
        ]
      },
      {
        "name": "LookupResult",
        "description": "What a lookup found.",
        "fields": [
          { "name": "items", "type": { "kind": "array", "items": { "kind": "ref", "name": "LookupItem" } } },
          { "name": "total", "type": { "kind": "ref", "name": "Int" } },
          { "name": "grid", "type": { "kind": "array", "items": { "kind": "array", "items": { "kind": "ref", "name": "Float", "nullable": true } } } }
        ]
      }
    ],
    "inputs": [
      {
        "name": "LookupInput",
        "fields": [
          { "name": "query", "required": true, "type": { "kind": "ref", "name": "String" } },
          { "name": "limit", "required": false, "type": { "kind": "ref", "name": "Int" }, "default": 10 },
          { "name": "kinds", "required": false, "type": { "kind": "array", "nullable": true, "items": { "kind": "ref", "name": "LookupKind" } } }
        ]
      }
    ],
    "enums": [
      {
        "name": "ErrorCode",
        "description": "The vocabulary of `extensions.code` on an error entry.",
        "members": [
          { "name": "BAD_REQUEST", "description": "The request was malformed." },
          { "name": "GRAPHQL_PARSE_FAILED" },
          { "name": "NOT_FOUND" }
        ]
      },
      {
        "name": "LookupKind",
        "members": [
          { "name": "FAST" },
          { "name": "SLOW", "deprecated": true, "description": "Slow. Avoid it." },
          { "name": "ROUND_TRIP" },
          { "name": "MTB_0" }
        ]
      }
    ],
    "scalars": [
      { "name": "Boolean", "builtin": true },
      { "name": "DateTime", "wire": { "kind": "string", "format": "date-time" } },
      { "name": "Float", "builtin": true },
      { "name": "GeoJSON", "wire": { "kind": "geojson", "geometry": "Geometry" } },
      { "name": "ID", "builtin": true },
      { "name": "Int", "builtin": true },
      { "name": "String", "builtin": true },
      { "name": "URL", "wire": { "kind": "string", "format": "uri" } }
    ]
  }
