{
  "enabled": true,
  "strategy_options": {
    "push_sessions": true
  },
  "telemetry": false,
  "checkpoints": {
    "primary": {
      "type": "git-refs"
    }
  },
  "commit_linking": "always",
  "redaction": {
    "betterleaks": {
      "enabled": true
    },
    "pii": {
      "enabled": true,
      "email": true,
      "phone": true,
      "address": false
    },
    "custom_redactions": {
      "mountaya_secret_key": "sk_[A-Za-z0-9]{16,}",
      "mountaya_session_token": "sess_[A-Za-z0-9_-]{16,}",
      "mountaya_share_token": "share_[0-9a-f]{32}"
    }
  }
}
